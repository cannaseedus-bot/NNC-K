{
  "kuhul": "1.0",
  "type": "program",
  "folds": [
    { "type": "fold", "name": "Pop", "nodes": [
      { "type": "literal", "value": "ResearchAssistant" }
    ] },
    { "type": "fold", "name": "Wo", "nodes": [
      { "type": "assign", "target": "params", "value": {
        "type": "literal", "value": { "max_sources": 8, "threshold": 0.72 }
      } }
    ] },
    { "type": "fold", "name": "Yax", "nodes": [
      { "type": "call", "name": "classify", "args": [{ "type": "ref", "name": "input.query" }] },
      { "type": "call", "name": "score", "args": [{ "type": "ref", "name": "candidates" }] }
    ] },
    { "type": "fold", "name": "Sek", "nodes": [
      { "type": "call", "name": "invoke", "args": [{ "type": "ref", "name": "NET-u" }, { "type": "ref", "name": "input.query" }] },
      { "type": "call", "name": "invoke", "args": [{ "type": "ref", "name": "REASON-u" }, { "type": "ref", "name": "evidence" }] },
      { "type": "call", "name": "invoke", "args": [{ "type": "ref", "name": "VERIFY-u" }, { "type": "ref", "name": "synthesis" }] }
    ] },
    { "type": "fold", "name": "Ch'en", "nodes": [
      { "type": "emit", "value": { "type": "ref", "name": "result" } }
    ] },
    { "type": "fold", "name": "Xul", "nodes": [
      { "type": "if", "test": { "type": "op", "op": ">=", "args": [{ "type": "ref", "name": "result.confidence" }, { "type": "literal", "value": 0.85 }] },
        "then": { "type": "block", "nodes": [
          { "type": "call", "name": "collapse", "args": [{ "type": "literal", "value": "ResearchAssistant" }] }
        ] },
        "else": { "type": "block", "nodes": [
          { "type": "call", "name": "fold", "args": [{ "type": "literal", "value": "ResearchAssistant" }] }
        ] }
      }
    ] }
  ]
}
